{
  "name": "zotero-hover-abstract",
  "type": "module",
  "version": "0.3.2",
  "description": "Shows fetched abstracts in Zotero's native citation hover popup",
  "config": {
    "addonName": "Zotero Hover Abstract",
    "addonID": "hover-abstract@localplugin.dev",
    "addonRef": "hoverabstract",
    "addonInstance": "HoverAbstract",
    "prefsPrefix": "extensions.zotero.hoverabstract"
  },
  "author": "Edouard Amouroux",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/edouardArmit/zotero-hover-abstract.git"
  },
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "test:unit": "node --import tsx ./node_modules/.bin/mocha \"test/unit/**/*.test.ts\"",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^10.11.0",
    "mocha": "^12.0.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "allowScripts": {
    "@swc/core": false,
    "es5-ext@0.10.64": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
